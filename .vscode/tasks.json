{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake --build ${workspaceFolder}/out/build/debug --config Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake --preset Qt-Debug",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
